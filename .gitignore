# macOS noise
.DS_Store

# Original full-resolution photos — only the optimized thumbs in
# assets/photos/ are deployed. Keep originals local.
assets/Pics for Website/

# Local-only SQL with real secrets baked in — never commit
supabase/*.local.sql

# supabase CLI scratch
supabase/.temp/

# Claude Code's local permission list — it accumulates real commands, and some
# of them have had admin passwords in them. A global ignore already catches it;
# this keeps that true for a fresh clone on another machine.
.claude/settings.local.json

# THE GARDEN — the audio itself lives on R2, never in git. git keeps every
# version of every file forever, and audio is the thing you re-master.
# tools/garden/encode.mjs writes these; assets/js/garden-catalog.js (which IS
# committed) is the index the room builds from.
assets/audio/garden/

# THE TOUR — the finished videos. Same reasoning as the garden's audio: git
# keeps every version of every file forever, and this is 36 MB a cut of a
# thing you re-shoot. It is also a PUBLIC repo that GitHub Pages serves, so
# a swept-in video is 36 MB in everyone's clone and on the CDN.
# The script IS committed (tools/tour/script.mjs) — that's the content, and
# `node tools/tour/record.mjs` makes the file again in ten minutes.
video/

# the wasm toolchain and the DSP sources it builds from. emsdk alone is over
# a gigabyte of LLVM; eurorack and stmlib are somebody else's repos. the
# RECIPE is committed (tools/mi/README.md + build_mi.sh) and the BINARY is
# committed (assets/wasm/mi.wasm) — the machinery in between is not.
tools/mi/work/
